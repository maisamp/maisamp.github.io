---
import { getEntry, render } from "astro:content";
import Icon from "../components/Icon.astro";
import Base from "../layouts/Base.astro";
import { formatDate } from "../utils";

const resume = (await getEntry("resume", "resume"))!;
const { Content } = await render(resume);
---

<Base title="Résumé">
	<div class="column">
		<div class="top">
			<div>
				<h1 class="page-title">Résumé</h1>
				<p class="updated">Updated {formatDate(resume.data.updated, "month")}</p>
			</div>
			{
				resume.data.pdf && (
					<a class="pdf" href={resume.data.pdf} download>
						<Icon name="download" size={18} /> PDF
					</a>
				)
			}
		</div>
		<div class="prose resume">
			<Content />
		</div>
	</div>
</Base>

<style>
	.top {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.updated {
		margin: 0;
		color: var(--muted);
		font-size: 0.9rem;
	}

	.pdf {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.5rem 1.1rem;
		border-radius: 99px;
		background: var(--accent-fill);
		color: var(--on-accent);
		font-weight: 650;
		text-decoration: none;
		white-space: nowrap;
	}

	.pdf:hover {
		filter: brightness(1.08);
	}

	.resume :global(h2) {
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent);
		margin: 2.5rem 0 1rem;
		padding-bottom: 0.35rem;
		border-bottom: 1px solid var(--line);
	}

	.resume :global(h3) {
		font-size: 1.08rem;
		margin: 1.5rem 0 0.35rem;
	}

	.resume :global(h3 small) {
		float: right;
		margin-left: 1rem;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--muted);
		line-height: 1.9;
	}

	@media (max-width: 520px) {
		.resume :global(h3 small) {
			float: none;
			display: block;
			margin: 0;
		}
	}
</style>
