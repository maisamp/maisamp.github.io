---
import PostList from "../../components/PostList.astro";
import Base from "../../layouts/Base.astro";
import { published } from "../../utils";

const posts = (await published("blog")).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<Base title="Blog" description="Writing on hardware, AI and building things.">
	<div class="column">
		<h1 class="page-title">Blog</h1>
		<p class="page-intro">Notes from building things.</p>
		{posts.length ? <PostList posts={posts} /> : <p class="empty">Nothing here yet.</p>}
	</div>
</Base>
