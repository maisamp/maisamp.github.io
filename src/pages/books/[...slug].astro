---
import { render } from "astro:content";
import BookCover from "../../components/BookCover.astro";
import Stars from "../../components/Stars.astro";
import Base from "../../layouts/Base.astro";
import { formatDate, published } from "../../utils";

export async function getStaticPaths() {
	const books = await published("books");
	return books.filter((b) => b.body?.trim()).map((book) => ({ params: { slug: book.id }, props: { book } }));
}

const { book } = Astro.props;
const { Content } = await render(book);
const { title, author, rating, finished, take } = book.data;
---

<Base title={`${title} by ${author}`} description={take}>
	<article class="column">
		<a class="back" href="/books/">← Books</a>
		<header>
			<div class="cover-wrap"><BookCover book={book} width={240} /></div>
			<div>
				<h1>{title}</h1>
				<p class="author">{author}</p>
				<Stars rating={rating} />
				<p class="finished">Finished {formatDate(finished, "month")}</p>
				<p class="take">“{take}”</p>
			</div>
		</header>
		<div class="prose">
			<Content />
		</div>
	</article>
</Base>

<style>
	.back {
		font-size: 0.9rem;
		text-decoration: none;
	}

	header {
		display: grid;
		grid-template-columns: 150px 1fr;
		gap: 1.75rem;
		align-items: end;
		margin: 1.25rem 0 2.25rem;
		padding-bottom: 1.75rem;
		border-bottom: 1px solid var(--line);
	}

	h1 {
		font-size: clamp(1.6rem, 4vw, 2.1rem);
		margin: 0;
	}

	.author {
		margin: 0.15rem 0 0.5rem;
		color: var(--muted);
	}

	.finished {
		margin: 0.25rem 0 0;
		font-size: 0.85rem;
		color: var(--muted);
	}

	.take {
		margin: 0.75rem 0 0;
		font-style: italic;
	}

	@media (max-width: 520px) {
		header {
			grid-template-columns: 110px 1fr;
			gap: 1.1rem;
		}
	}
</style>
