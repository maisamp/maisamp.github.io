---
import BookCover from "../../components/BookCover.astro";
import Stars from "../../components/Stars.astro";
import Base from "../../layouts/Base.astro";
import { published } from "../../utils";

const books = (await published("books")).sort((a, b) => b.data.finished.valueOf() - a.data.finished.valueOf());
---

<Base title="Books" description="Books I love, and what I thought of them.">
	<div class="column wide">
		<h1 class="page-title">Books</h1>
		<p class="page-intro">Books I love, and what I thought of them.</p>

		{books.length === 0 && <p class="empty">Reviews coming soon.</p>}

		<ul class="shelf">
			{
				books.map((book) => {
					const hasReview = Boolean(book.body?.trim());
					const Tag = hasReview ? "a" : "div";
					return (
						<li>
							<Tag class="book" href={hasReview ? `/books/${book.id}/` : undefined}>
								<BookCover book={book} />
								<h2>{book.data.title}</h2>
								<p class="author">{book.data.author}</p>
								<Stars rating={book.data.rating} />
								<p class="take">{book.data.take}</p>
								{hasReview && <span class="read">Read review →</span>}
							</Tag>
						</li>
					);
				})
			}
		</ul>
	</div>
</Base>

<style>
	.wide {
		max-width: 960px;
	}

	.shelf {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
		gap: 2.5rem 1.75rem;
	}

	.book {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.book :global(.cover) {
		transition: transform 0.2s ease;
	}

	a.book:hover :global(.cover) {
		transform: translateY(-4px) rotate(-1deg);
	}

	h2 {
		font-size: 1rem;
		font-weight: 650;
		margin: 0.9rem 0 0.1rem;
	}

	a.book:hover h2 {
		color: var(--accent);
	}

	.author {
		margin: 0 0 0.2rem;
		font-size: 0.88rem;
		color: var(--muted);
	}

	.take {
		margin: 0.35rem 0 0;
		font-size: 0.9rem;
		line-height: 1.5;
	}

	.read {
		display: inline-block;
		margin-top: 0.4rem;
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--accent);
	}

	@media (max-width: 480px) {
		.shelf {
			grid-template-columns: repeat(2, 1fr);
			gap: 2rem 1.1rem;
		}
	}
</style>
