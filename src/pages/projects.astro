---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { formatDate, published } from "../utils";

const projects = (await published("projects")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Projects" description="Things I've built.">
	<div class="column wide">
		<h1 class="page-title">Projects</h1>
		<p class="page-intro">Things I've built, mostly at the edge of hardware and AI.</p>

		{projects.length === 0 && <p class="empty">Nothing here yet.</p>}

		<ul class="projects">
			{
				projects.map(({ data }) => (
					<li class="project">
						<div class="thumb">
							{typeof data.image === "string" ? (
								<img src={data.image} alt={data.imageAlt} loading="lazy" />
							) : data.image ? (
								<Image src={data.image} alt={data.imageAlt} width={480} />
							) : (
								<span aria-hidden="true">🦦</span>
							)}
						</div>
						<div>
							<h2>{data.title}</h2>
							<p class="date">{formatDate(data.date, "month")}</p>
							<p>{data.summary}</p>
							{data.links.length > 0 && (
								<p class="links">
									{data.links.map((l, i) => (
										<>
											{i > 0 && <span aria-hidden="true"> / </span>}
											<a href={l.href}>{l.label}</a>
										</>
									))}
								</p>
							)}
							{data.tags.length > 0 && (
								<ul class="tags">
									{data.tags.map((t) => (
										<li>{t}</li>
									))}
								</ul>
							)}
						</div>
					</li>
				))
			}
		</ul>
	</div>
</Base>

<style>
	.wide {
		max-width: 860px;
	}

	.projects {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.project {
		display: grid;
		grid-template-columns: 240px 1fr;
		gap: 1.75rem;
		align-items: start;
		padding: 1.75rem 0;
		border-bottom: 1px solid var(--rule);
	}

	.project:first-child {
		padding-top: 0.5rem;
	}

	.project:last-child {
		border-bottom: 0;
	}

	.thumb {
		aspect-ratio: 40 / 21;
		border-radius: 8px;
		overflow: hidden;
		background: var(--surface);
		box-shadow: var(--shadow);
		display: grid;
		place-items: center;
		font-size: 3rem;
	}

	.thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	h2 {
		font-size: 1.2rem;
		margin: 0;
	}

	.date {
		margin: 0.1rem 0 0.5rem;
		font-size: 0.85rem;
		color: var(--muted);
	}

	p {
		margin: 0 0 0.5rem;
	}

	.links {
		font-weight: 600;
	}

	.tags {
		list-style: none;
		padding: 0;
		margin: 0.6rem 0 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.tags li {
		font-size: 0.8rem;
		padding: 0.1rem 0.6rem;
		border-radius: 99px;
		border: 1px solid var(--line);
		color: var(--muted);
	}

	@media (max-width: 640px) {
		.project {
			grid-template-columns: 1fr;
			gap: 1rem;
		}
	}
</style>
