---
import { Image } from "astro:assets";
import { render } from "astro:content";
import Toc from "../components/Toc.astro";
import { coverFor } from "../covers";
import Base from "../layouts/Base.astro";
import { published } from "../utils";

const books = (await published("books")).sort((a, b) => b.data.read.valueOf() - a.data.read.valueOf());
const rendered = await Promise.all(books.map(async (b) => ({ ...b, Content: (await render(b)).Content })));
const toc = rendered.map(({ id, data }) => ({ id, text: data.title }));

// Muted tones for the placeholder tile shown until (or instead of) a real cover
const tones = ["#0b716c", "#3d5870", "#7a5c3e", "#5b6b3a", "#6b4a63", "#35607a"];
const tone = (s: string) => tones[[...s].reduce((n, c) => n + c.charCodeAt(0), 0) % tones.length];
---

<Base title="Books" description="Books I loved.">
	<div class="with-toc">
		<div class="main">
			<h1 class="page-title">Books</h1>
			<p class="page-intro">Books I loved.</p>

			{rendered.length === 0 && <p class="empty">Coming soon.</p>}

			{toc.length > 1 && <Toc items={toc} title="On the shelf" variant="inline" />}

			{
				rendered.map(({ id, data, Content }) => {
					const cover = coverFor(id);
					return (
						<article class="book" id={id}>
							<header class="book-head">
								<div class="cover" style={`--tone: ${tone(data.title)}`} aria-hidden="true">
									<span>{data.title.replace(/^(The|A|An) /, "").charAt(0)}</span>
									{cover && <Image src={cover} alt="" width={144} />}
								</div>
								<div class="head-text">
									<h2>
										<a href={`#${id}`}>{data.title}</a>
									</h2>
									<p class="author">{data.author}</p>
									<button class="share" type="button" data-url={`/books/${id}/`} data-title={`${data.title} by ${data.author}`}>
										<svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true">
											<path
												fill="none"
												stroke="currentColor"
												stroke-width="2"
												stroke-linecap="round"
												stroke-linejoin="round"
												d="M10 14a4.5 4.5 0 0 0 6.4 0l3.2-3.2a4.5 4.5 0 0 0-6.4-6.4L11.8 6M14 10a4.5 4.5 0 0 0-6.4 0l-3.2 3.2a4.5 4.5 0 0 0 6.4 6.4l1.4-1.4"
											/>
										</svg>
										<span>Share</span>
									</button>
								</div>
							</header>
							<div class="prose">
								<Content />
							</div>
						</article>
					);
				})
			}
		</div>

		{toc.length > 1 && <Toc items={toc} title="On the shelf" variant="side" />}
	</div>
</Base>

<script>
	// Highlight the book a link points at, so a shared link lands visibly on it
	function spotlight(id: string) {
		const el = document.getElementById(id);
		if (!el?.classList.contains("book")) return;
		el.classList.remove("spotlight");
		void el.offsetWidth;
		el.classList.add("spotlight");
	}
	const fromHash = () => location.hash.length > 1 && spotlight(decodeURIComponent(location.hash.slice(1)));
	window.addEventListener("hashchange", fromHash);
	fromHash();

	// Share: the phone share sheet where there is one, otherwise copy the link
	document.querySelectorAll<HTMLButtonElement>(".share").forEach((btn) =>
		btn.addEventListener("click", async () => {
			const url = new URL(btn.dataset.url!, location.origin).href;
			const label = btn.querySelector("span")!;
			if (navigator.share && matchMedia("(pointer: coarse)").matches) {
				try {
					await navigator.share({ title: btn.dataset.title, url });
					return;
				} catch {
					// cancelled or unavailable: fall through to copying
				}
			}
			try {
				await navigator.clipboard.writeText(url);
				label.textContent = "Link copied";
			} catch {
				prompt("Copy this link:", url);
			}
			setTimeout(() => (label.textContent = "Share"), 2000);
		}),
	);
</script>

<style>
	.book {
		padding: 2rem 1.25rem;
		margin: 0 -1.25rem;
		border-top: 1px solid var(--rule);
		border-radius: 10px;
		scroll-margin-top: 1.5rem;
	}

	.book:first-of-type {
		border-top: 0;
	}

	.book.spotlight {
		animation: spotlight 2.8s ease-out;
	}

	@keyframes spotlight {
		0%,
		35% {
			background: var(--accent-soft);
			box-shadow: inset 3px 0 0 var(--accent);
		}
		100% {
			background: transparent;
			box-shadow: inset 3px 0 0 transparent;
		}
	}

	h2 {
		font-size: 1.3rem;
		font-weight: 600;
		margin: 0;
		text-wrap: balance;
	}

	h2 a {
		color: inherit;
		text-decoration: none;
	}

	h2 a:hover {
		color: var(--accent);
	}

	.book-head {
		display: flex;
		gap: 1.1rem;
		align-items: flex-start;
		margin-bottom: 1rem;
	}

	.head-text {
		min-width: 0;
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	/* A small cover, like a book spine on a shelf */
	.cover {
		position: relative;
		flex: none;
		width: 72px;
		aspect-ratio: 2 / 3;
		border-radius: 2px 5px 5px 2px;
		overflow: hidden;
		background: linear-gradient(160deg, color-mix(in srgb, var(--tone) 80%, white), var(--tone));
		box-shadow: var(--shadow);
		display: grid;
		place-items: center;
	}

	.cover::after {
		content: "";
		position: absolute;
		inset: 0 auto 0 0;
		width: 5px;
		background: linear-gradient(90deg, rgb(0 0 0 / 0.2), transparent);
		z-index: 2;
	}

	.cover span {
		font-size: 1.9rem;
		font-weight: 500;
		color: rgb(255 255 255 / 0.85);
	}

	.cover img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: 1;
	}

	.author {
		margin: 0.1rem 0 0.6rem;
		color: var(--muted);
		font-style: italic;
	}

	@media (max-width: 520px) {
		.cover {
			width: 60px;
		}
	}

	.share {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		flex: none;
		font: inherit;
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--muted);
		background: none;
		border: 1px solid var(--line);
		border-radius: 99px;
		padding: 0.2rem 0.7rem;
		cursor: pointer;
		transition:
			color 0.15s,
			border-color 0.15s;
	}

	.share:hover {
		color: var(--accent);
		border-color: var(--accent);
	}

	.prose :global(p:last-child) {
		margin-bottom: 0;
	}
</style>
