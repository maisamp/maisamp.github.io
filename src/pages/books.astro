---
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import { published } from "../utils";

const books = (await published("books")).sort((a, b) => b.data.read.valueOf() - a.data.read.valueOf());
const rendered = await Promise.all(books.map(async (b) => ({ ...b, Content: (await render(b)).Content })));
---

<Base title="Books" description="Books I loved.">
	<div class="shelf">
		<div class="main">
			<h1 class="page-title">Books</h1>
			<p class="page-intro">Books I loved.</p>

			{rendered.length === 0 && <p class="empty">Coming soon.</p>}

			{
				rendered.length > 1 && (
					<details class="toc-mobile">
						<summary>All books ({rendered.length})</summary>
						<ol>
							{rendered.map(({ id, data }) => (
								<li>
									<a href={`#${id}`}>{data.title}</a>
								</li>
							))}
						</ol>
					</details>
				)
			}

			{
				rendered.map(({ id, data, Content }) => (
					<article class="book" id={id}>
						<h2>
							<a href={`#${id}`}>{data.title}</a>
						</h2>
						<div class="byline">
							<p class="author">{data.author}</p>
							<button class="share" type="button" data-url={`/books/${id}/`} data-title={`${data.title} by ${data.author}`}>
								<svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true">
									<path
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
										d="M10 14a4.5 4.5 0 0 0 6.4 0l3.2-3.2a4.5 4.5 0 0 0-6.4-6.4L11.8 6M14 10a4.5 4.5 0 0 0-6.4 0l-3.2 3.2a4.5 4.5 0 0 0 6.4 6.4l1.4-1.4"
									/>
								</svg>
								<span>Share</span>
							</button>
						</div>
						<div class="prose">
							<Content />
						</div>
					</article>
				))
			}
		</div>

		{
			rendered.length > 1 && (
				<nav class="toc" aria-label="Books on this page">
					<p class="toc-title">On the shelf</p>
					<ol>
						{rendered.map(({ id, data }) => (
							<li>
								<a href={`#${id}`} data-id={id}>
									{data.title}
								</a>
							</li>
						))}
					</ol>
				</nav>
			)
		}
	</div>
</Base>

<script>
	const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>(".toc a")];
	const books = [...document.querySelectorAll<HTMLElement>(".book")];
	// A linked book stays selected in the contents until you scroll yourself
	let pinned: string | null = null;

	function markCurrent(id: string | undefined) {
		tocLinks.forEach((a) => (a.dataset.id === id ? a.setAttribute("aria-current", "true") : a.removeAttribute("aria-current")));
	}

	function updateCurrent() {
		if (pinned) return markCurrent(pinned);
		const atBottom = innerHeight + scrollY >= document.documentElement.scrollHeight - 4;
		let current = books[0];
		for (const b of books) if (b.getBoundingClientRect().top <= innerHeight * 0.3) current = b;
		markCurrent((atBottom ? books.at(-1) : current)?.id);
	}

	// Highlight the book a link points at, so a shared link lands visibly on it
	function spotlight(id: string) {
		const el = document.getElementById(id);
		if (!el) return;
		el.classList.remove("spotlight");
		void el.offsetWidth;
		el.classList.add("spotlight");
		pinned = id;
		markCurrent(id);
	}
	const fromHash = () => location.hash.length > 1 && spotlight(decodeURIComponent(location.hash.slice(1)));
	window.addEventListener("hashchange", fromHash);
	for (const ev of ["wheel", "touchmove", "keydown"]) addEventListener(ev, () => (pinned = null), { passive: true });
	let queued = false;
	addEventListener("scroll", () => {
		if (queued) return;
		queued = true;
		requestAnimationFrame(() => {
			queued = false;
			updateCurrent();
		});
	});
	fromHash();
	updateCurrent();

	// Close the phone contents list after picking a book
	document.querySelectorAll<HTMLAnchorElement>(".toc-mobile a").forEach((a) =>
		a.addEventListener("click", () => a.closest("details")?.removeAttribute("open")),
	);

	// Share: the phone share sheet where there is one, otherwise copy the link
	document.querySelectorAll<HTMLButtonElement>(".share").forEach((btn) =>
		btn.addEventListener("click", async () => {
			const url = new URL(btn.dataset.url!, location.origin).href;
			const label = btn.querySelector("span")!;
			if (navigator.share && matchMedia("(pointer: coarse)").matches) {
				try {
					await navigator.share({ title: btn.dataset.title, url });
					return;
				} catch {
					// cancelled or unavailable: fall through to copying
				}
			}
			try {
				await navigator.clipboard.writeText(url);
				label.textContent = "Link copied";
			} catch {
				prompt("Copy this link:", url);
			}
			setTimeout(() => (label.textContent = "Share"), 2000);
		}),
	);

</script>

<style>
	.shelf {
		display: grid;
		grid-template-columns: minmax(0, 680px);
		justify-content: center;
		gap: 4rem;
	}

	@media (min-width: 1080px) {
		.shelf {
			grid-template-columns: minmax(0, 680px) 220px;
		}
	}

	.book {
		padding: 2rem 1.25rem;
		margin: 0 -1.25rem;
		border-top: 1px solid var(--rule);
		border-radius: 10px;
		scroll-margin-top: 1.5rem;
	}

	.book:first-of-type {
		border-top: 0;
	}

	.book.spotlight {
		animation: spotlight 2.8s ease-out;
	}

	@keyframes spotlight {
		0%,
		35% {
			background: var(--accent-soft);
			box-shadow: inset 3px 0 0 var(--accent);
		}
		100% {
			background: transparent;
			box-shadow: inset 3px 0 0 transparent;
		}
	}

	h2 {
		font-size: 1.3rem;
		font-weight: 600;
		margin: 0;
		text-wrap: balance;
	}

	h2 a {
		color: inherit;
		text-decoration: none;
	}

	h2 a:hover {
		color: var(--accent);
	}

	.byline {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin: 0.1rem 0 0.9rem;
	}

	.author {
		margin: 0;
		color: var(--muted);
		font-style: italic;
	}

	.share {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		flex: none;
		font: inherit;
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--muted);
		background: none;
		border: 1px solid var(--line);
		border-radius: 99px;
		padding: 0.2rem 0.7rem;
		cursor: pointer;
		transition:
			color 0.15s,
			border-color 0.15s;
	}

	.share:hover {
		color: var(--accent);
		border-color: var(--accent);
	}

	.prose :global(p:last-child) {
		margin-bottom: 0;
	}

	/* Contents: sticky list on wide screens */
	.toc {
		display: none;
	}

	@media (min-width: 1080px) {
		.toc {
			display: block;
			position: sticky;
			top: 2rem;
			align-self: start;
			margin-top: 5.5rem;
			max-height: calc(100vh - 4rem);
			overflow-y: auto;
		}
	}

	.toc-title {
		margin: 0 0 0.6rem;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.toc ol,
	.toc-mobile ol {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.toc a {
		display: block;
		padding: 0.3rem 0 0.3rem 0.8rem;
		border-left: 2px solid var(--rule);
		font-size: 0.9rem;
		line-height: 1.35;
		color: var(--muted);
		text-decoration: none;
		transition:
			color 0.15s,
			border-color 0.15s;
	}

	.toc a:hover {
		color: var(--heading);
	}

	.toc a[aria-current="true"] {
		color: var(--accent);
		border-left-color: var(--accent);
		font-weight: 600;
	}

	/* Contents: a collapsible list on phones and tablets */
	.toc-mobile {
		margin: 0 0 1rem;
		border: 1px solid var(--line);
		border-radius: 10px;
		padding: 0.6rem 1rem;
	}

	.toc-mobile summary {
		cursor: pointer;
		font-weight: 600;
		color: var(--heading);
	}

	.toc-mobile ol {
		margin-top: 0.5rem;
	}

	.toc-mobile a {
		display: block;
		padding: 0.3rem 0;
		text-decoration: none;
	}

	@media (min-width: 1080px) {
		.toc-mobile {
			display: none;
		}
	}
</style>
