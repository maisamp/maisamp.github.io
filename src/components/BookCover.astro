---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
	book: CollectionEntry<"books">;
	width?: number;
}

const { book, width = 300 } = Astro.props;
const { title, author, isbn, cover } = book.data;
---

<div class="cover">
	{
		cover ? (
			<Image src={cover} alt="" width={width} />
		) : isbn ? (
			<img
				src={`https://covers.openlibrary.org/b/isbn/${isbn.replace(/-/g, "")}-L.jpg?default=false`}
				alt=""
				loading="lazy"
				onerror="this.remove()"
			/>
		) : null
	}
	<div class="fallback" aria-hidden="true">
		<strong>{title}</strong>
		<span>{author}</span>
	</div>
</div>

<style>
	.cover {
		position: relative;
		aspect-ratio: 2 / 3;
		border-radius: 3px 6px 6px 3px;
		overflow: hidden;
		box-shadow: var(--shadow);
		background: linear-gradient(160deg, var(--accent-fill), #164a5c);
	}

	/* The spine */
	.cover::after {
		content: "";
		position: absolute;
		inset: 0 auto 0 0;
		width: 6px;
		background: linear-gradient(90deg, rgb(0 0 0 / 0.18), transparent);
		z-index: 2;
	}

	.cover img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: 1;
	}

	.fallback {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.5rem;
		padding: 1rem;
		text-align: center;
		color: #fff;
		line-height: 1.25;
	}

	.fallback strong {
		font-size: 1rem;
		font-weight: 650;
	}

	.fallback span {
		font-size: 0.8rem;
		opacity: 0.85;
	}
</style>
